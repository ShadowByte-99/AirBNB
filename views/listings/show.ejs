<% layout("layouts/boilerplate") %>

<style>
    .listing-container {
        max-width: 700px;
        margin: 30px auto;
        padding: 20px;
        font-family: Arial, Helvetica, sans-serif;
        color: #333;
    }

    .listing-container h1 {
        text-align: center;
        margin-bottom: 20px;
        color: #222;
    }

    .listing-image {
        width: 100%;
        max-height: 450px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .listing-container h2 {
        margin-top: 20px;
        font-size: 1.8rem;
        color: #ff385c;
    }

    .listing-details {
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }

    .listing-details li {
        padding: 10px 0;
        border-bottom: 1px solid #eee;
        font-size: 1.05rem;
    }

    .listing-details li strong {
        display: inline-block;
        width: 120px;
        color: #555;
    }

    .actions {
        margin-top: 30px;
        text-align: center;
    }

    .btn {
        display: inline-block;
        padding: 10px 22px;
        margin: 8px;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .btn:hover {
        opacity: 0.85;
    }

    .btn-edit {
        background-color: #222;
        color: #fff;
    }

    .btn-delete {
        background-color: #ff385c;
        color: #fff;
    }

    .btn-small {
        padding: 5px 12px;
        font-size: 0.85rem;
        margin: 5px 0 0;
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 25px;
        color: #ff385c;
        text-decoration: none;
        font-weight: bold;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    /* Reviews */
    .review-section {
        margin-top: 30px;
    }

    .review-section h3 {
        margin-bottom: 15px;
        color: #222;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: bold;
        color: #555;
    }

    .form-group textarea {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-family: inherit;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .review-card {
        padding: 12px 15px;
        margin-bottom: 12px;
        border: 1px solid #eee;
        border-radius: 8px;
    }

    .review-rating {
        color: #ff385c;
        font-weight: bold;
        margin: 0 0 6px;
    }
</style>

<div class="listing-container">

    <h1>Listing Details</h1>

    <img
        src="<%= listing.image.url %>"
        alt="listing image"
        class="listing-image"
    >

    <h2><%= listing.title %></h2>

    <ul class="listing-details">
        <li><strong>Description:</strong> <%= listing.description %></li>
        <li><strong>Price:</strong> ₹<%= listing.price %></li>
        <li><strong>Location:</strong> <%= listing.location %></li>
        <li><strong>Country:</strong> <%= listing.country %></li>
    </ul>

    <hr>

    <div class="actions">
        <!-- EDIT -->
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit">
            EDIT THIS LISTING
        </a>

        <!-- DELETE -->
        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            style="display: inline;"
        >
            <button type="submit" class="btn btn-delete">
                DELETE THIS LISTING
            </button>
        </form>
    </div>

    <hr>

    <!-- REVIEW FORM -->
    <div class="review-section">
        <h3>Leave a Review</h3>

        <form method="POST" action="/listings/<%= listing._id %>/reviews">
            <div class="form-group">
                <label for="rating">Rating</label>
                <input
                    type="range"
                    id="rating"
                    name="review[rating]"
                    min="1"
                    max="5"
                    value="3"
                    oninput="document.getElementById('ratingValue').textContent = this.value"
                >
                <span id="ratingValue">3</span> / 5
            </div>

            <div class="form-group">
                <label for="comment">Comment</label>
                <textarea
                    id="comment"
                    name="review[comment]"
                    rows="4"
                    placeholder="Share your experience..."
                    required
                ></textarea>
            </div>

            <button type="submit" class="btn btn-edit">Submit Review</button>
        </form>
    </div>

    <hr>

    <!-- ALL REVIEWS -->
    <div class="review-section">
        <h3>All Reviews</h3>

        <% if (listing.reviews.length === 0) { %>
            <p>No reviews yet. Be the first to review!</p>
        <% } %>

        <% for (let review of listing.reviews) { %>
            <div class="review-card">
                <p class="review-rating">★ <%= review.rating %> / 5</p>
                <p><%= review.comment %></p>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                >
                    <button type="submit" class="btn btn-delete btn-small">Delete</button>
                </form>
            </div>
        <% } %>
    </div>

    <a href="/listings" class="back-link">
        ← BACK TO ALL LISTINGS
    </a>

</div>